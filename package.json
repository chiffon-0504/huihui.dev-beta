{
  "name": "huihui-dev-beta",
  "private": true,
  "scripts": {
    "dev:v2": "vite --config vite.v2.config.mjs",
    "check:ts": "npm run check:v2:types",
    "check:v2:types": "tsc --project v2/tsconfig.json --noEmit",
    "build:v2": "npm run check:v2:types && vite build --config vite.v2.config.mjs",
    "check:v2:performance": "npm run build:v2 && node v2/tools/check-performance.mjs",
    "preview:v2": "vite preview --config vite.v2.config.mjs",
    "test:e2e:v2": "npm run build:v2 && playwright test --config playwright.v2.config.mjs",
    "check:js": "node tests/scripts/check-js.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run check:js && npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "^4.1.11",
    "yaml": "2.8.3"
  }
}
